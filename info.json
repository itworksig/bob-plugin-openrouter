{
    "identifier": "com.openrouter.translate",
    "type": "translate",
    "name": "OpenRouter",
    "version": "0.1.12",
    "supportedLanguages": [
        "auto",
        "zh-Hans",
        "zh-Hant",
        "en",
        "ja",
        "ko",
        "fr",
        "de",
        "es",
        "it",
        "ru",
        "pt",
        "nl",
        "pl",
        "ar",
        "af",
        "hi",
        "th",
        "vi",
        "uz",
        "tg",
        "fa",
        "kk",
        "ur",
        "id",
        "ms",
        "pa",
        "ps"
    ],
    "homepage": "https://github.com/itworksig/bob-plugin-openrouter",
    "appcast": "https://raw.githubusercontent.com/itworksig/bob-plugin-openrouter/main/appcast.json",
    "category": "translate",
    "icon": "icon.png",
    "author": "DemoChen",
    "minBobVersion": "0.5.0",
    "options": [
        {
            "identifier": "apiKey",
            "type": "text",
            "title": "API Key",
            "desc": "OpenRouter API Key"
        },
        {
            "identifier": "apiBase",
            "type": "text",
            "title": "API Base URL",
            "defaultValue": "https://openrouter.ai/api/v1",
            "desc": "OpenRouter API Base URL",
            "text": "https://openrouter.ai/api/v1",
            "readonly": true
        },
        {
            "identifier": "model",
            "type": "menu",
            "title": "AI Model",
            "defaultValue": "openai/gpt-3.5-turbo",
            "menuValues": [
                {
                    "title": "GPT-3.5 Turbo",
                    "value": "openai/gpt-3.5-turbo"
                },
                {
                    "title": "GPT-4",
                    "value": "openai/gpt-4"
                },
                {
                    "title": "Claude 2.1",
                    "value": "anthropic/claude-2.1"
                },
                {
                    "title": "Claude 3 Opus",
                    "value": "anthropic/claude-3-opus"
                },
                {
                    "title": "Claude 3 Sonnet",
                    "value": "anthropic/claude-3-sonnet"
                },
                {
                    "title": "Gemini Pro",
                    "value": "google/gemini-pro"
                },
                {
                    "title": "Mixtral 8x7B",
                    "value": "mistralai/mixtral-8x7b"
                },
                {
                    "title": "Llama 2 70B",
                    "value": "meta-llama/llama-2-70b-chat"
                },
                {
                    "title": "Code Llama 34B",
                    "value": "codellama/codellama-34b-instruct"
                },
                {
                    "title": "Qwen 72B",
                    "value": "qwen/qwen-72b-chat"
                },
                {
                    "title": "自定义模型",
                    "value": "custom"
                }
            ]
        },
        {
            "identifier": "customModel",
            "type": "text",
            "title": "自定义模型名称",
            "desc": "当选择「自定义模型」时需要填写完整的模型ID",
            "placeholder": "例如: anthropic/claude-3-opus",
            "condition": {
                "model": "custom"
            }
        },
        {
            "identifier": "promptMode",
            "type": "menu",
            "title": "Prompt 模式",
            "defaultValue": "translate",
            "desc": "翻译模式使用内置翻译提示词；自定义模式使用下方填写的 Prompt",
            "menuValues": [
                {
                    "title": "翻译模式",
                    "value": "translate"
                },
                {
                    "title": "自定义模式",
                    "value": "custom"
                }
            ]
        },
        {
            "identifier": "customPrompt",
            "type": "text",
            "title": "自定义 Prompt",
            "defaultValue": "你是一个翻译助手。请把用户文本翻译成{to}，只返回译文，不要解释。",
            "desc": "仅自定义模式生效。{from} 为源语言，{to} 为目标语言。写了 {text} 时，整段 Prompt 作为用户消息；没写时，Prompt 作为系统提示，原文单独发送。",
            "textConfig": {
                "type": "visible",
                "height": 120
            },
            "condition": {
                "promptMode": "custom"
            }
        }
    ]
} 